@page "/spielen/sprint"
@model KeyWars.Pages.Spielen.SprintModel
@{
    ViewData["Title"] = "Sprint";
    ViewData["BodyClass"] = "typing-focus-page";
}

<section class="page-header">
    <div>
        <span class="eyebrow">Zeitdruck</span>
        <h1>Sprint</h1>
        <p class="lead">Zeitmodus mit deutschen Wörtern. Wähle die Dauer und starte die Runde.</p>
    </div>
</section>

<nav class="typing-mode-selector" aria-label="Sprintdauer auswählen">
    @foreach (var item in Model.Modes)
    {
        var selected = item.Seconds == Model.SelectedSeconds;
        <a class="typing-mode-chip @(selected ? "active" : "")"
           asp-page="/Spielen/Sprint"
           asp-route-seconds="@item.Seconds"
           aria-current="@(selected ? "page" : null)">
            <strong>@item.Seconds</strong>
            <span>Sekunden</span>
        </a>
    }
</nav>

<section class="card typing-session-card typing-focus-primary typing-mode-workspace" data-typing-app data-mode="@Model.SelectedMode" data-seconds="@Model.SelectedSeconds" data-words="120" data-hide-start-when-prepared="true">
    <h2>@Model.SelectedSeconds Sekunden</h2>
    <div class="typing-target" data-target tabindex="0" role="region" aria-label="Zieltext des Sprints"></div>
    <label class="typing-input-wrap">
        Eingabe
        <textarea class="typing-input" data-input disabled autocapitalize="off" autocomplete="off" spellcheck="false"></textarea>
    </label>
    <div class="form-actions typing-actions">
        <button type="button" data-start>Starten</button>
    </div>
    <div data-result></div>
</section>
