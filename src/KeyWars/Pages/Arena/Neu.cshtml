@page "/arena/neu"
@model KeyWars.Pages.Arena.NeuModel
@{
    ViewData["Title"] = "Live-Raum starten";
    var selectedText = Model.SelectedTextOption;
    var selectedTextStats = selectedText is null
        ? ""
        : $"{selectedText.WordCount} Wörter · {selectedText.CharacterCount} Zeichen · ca. {selectedText.EstimatedSeconds} s";
}

<section class="page-header">
    <div>
        <h1>Live-Raum starten</h1>
        <p class="lead">Erstelle ein Einzelrennen, eine Serie oder eine Teamwertung für 2 bis @Model.MaxParticipantsLimit Personen.</p>
    </div>
</section>

<section class="arena-create-layout">
    <form method="post" class="card form-grid arena-create-form" data-arena-create-form data-submit-guard data-submit-busy-text="Raum wird erstellt...">
        <div asp-validation-summary="ModelOnly" role="alert" aria-live="assertive" aria-atomic="true" tabindex="-1"></div>
        <label>
            Titel
            <input asp-for="Input.Title" maxlength="160" placeholder="Zum Beispiel: Mittagspause Sprint" />
            <span asp-validation-for="Input.Title"></span>
        </label>
        <label>
            Text
            <select asp-for="Input.TrainingTextId" data-arena-text-select aria-describedby="arena-text-limit text-preview-title text-preview-body">
                @foreach (var text in Model.TextOptions)
                {
                    <option value="@text.Id"
                            data-title="@text.Title"
                            data-preview="@text.Preview"
                            data-characters="@text.CharacterCount"
                            data-words="@text.WordCount"
                            data-duration="@text.EstimatedSeconds">@text.Title</option>
                }
            </select>
            <span asp-validation-for="Input.TrainingTextId"></span>
            <small id="arena-text-limit" class="muted">
                Live-Texte sind auf @Model.MaxArenaTargetGraphemes Grapheme und @(KeyWars.Services.LiveOptions.MaximumSafeArenaTargetUtf8Bytes / 1024) KiB UTF-8 begrenzt.
                @if (Model.ExcludedTextCount > 0)
                {
                    <span>@Model.ExcludedTextCount @(Model.ExcludedTextCount == 1 ? "sichtbarer Text wurde" : "sichtbare Texte wurden") deshalb ausgeblendet.</span>
                }
            </small>
        </label>
        <fieldset class="arena-mode-picker" aria-describedby="arena-mode-help">
            <legend>Modus</legend>
            <p id="arena-mode-help" class="muted">Wähle zwischen einem schnellen Einzelrennen, einer Mehrrunden-Serie und einer gemeinsamen Teamwertung.</p>
            <label class="arena-mode-card @(Model.Input.Mode == LiveRoomMode.Classic ? "selected" : "")">
                <input asp-for="Input.Mode" type="radio" value="Classic" data-arena-mode-input />
                <span class="arena-mode-card-header">
                    <strong>Klassisches Rennen</strong>
                    <span>1 Runde</span>
                </span>
                <span>Alle tippen denselben Text nach einem Countdown. Fortschritt, Fehler und Zieleinlauf werden live sichtbar.</span>
                <span class="arena-mode-steps">Lobby → Countdown → Rennen → Ergebnis</span>
            </label>
            <label class="arena-mode-card @(Model.Input.Mode == LiveRoomMode.Series ? "selected" : "")">
                <input asp-for="Input.Mode" type="radio" value="Series" data-arena-mode-input />
                <span class="arena-mode-card-header">
                    <strong>Serienrennen</strong>
                    <span>3 oder 5 Runden</span>
                </span>
                <span>Platzierungspunkte werden über alle Runden addiert. Rundensiege und Gesamtzeit entscheiden bei Gleichstand.</span>
                <span class="arena-mode-steps">Lobby → Runde 1 → Rundenergebnis → nächste Runde → Gesamtwertung</span>
            </label>
            <label class="arena-mode-card @(Model.Input.Mode == LiveRoomMode.Team ? "selected" : "")">
                <input asp-for="Input.Mode" type="radio" value="Team" data-arena-mode-input />
                <span class="arena-mode-card-header">
                    <strong>Teamwertung</strong>
                    <span>Alpha gegen Bravo</span>
                </span>
                <span>Beitretende werden automatisch ausgeglichen verteilt. Jeder Zieleinlauf sammelt Punkte für das gemeinsame Team.</span>
                <span class="arena-mode-steps">Lobby → Countdown → Teamrennen → Teamresultat</span>
            </label>
            <span asp-validation-for="Input.Mode"></span>
        </fieldset>
        <label data-arena-round-count-group class="@(Model.Input.Mode == LiveRoomMode.Series ? "" : "is-hidden")">
            Runden der Serie
            <select asp-for="Input.RoundCount" data-arena-round-count>
                <option value="1">Eine Runde</option>
                <option value="3">Drei Runden</option>
                <option value="5">Fünf Runden</option>
            </select>
            <span asp-validation-for="Input.RoundCount"></span>
        </label>
        <div class="text-preview-box" data-arena-text-preview>
            <div class="text-preview-meta">
                <span>Textvorschau</span>
                <strong id="text-preview-title" data-text-preview-title>@(selectedText?.Title ?? "Kein Text verfügbar")</strong>
                <small data-text-preview-stats>@selectedTextStats</small>
            </div>
            <p id="text-preview-body" data-text-preview-body>@(selectedText?.Preview ?? "Lege zuerst einen Trainingstext an.")</p>
        </div>
        <label>
            Sichtbarkeit
            <select asp-for="Input.Visibility" data-arena-visibility>
                <option value="Code">Nur mit Raumcode</option>
                <option value="InternalOpen">Intern offen</option>
                <option value="InvitationOnly">Nur eingeladene Personen</option>
            </select>
        </label>
        <fieldset class="person-picker @(Model.Input.Visibility == LiveRoomVisibility.InvitationOnly ? "" : "is-hidden")"
                  data-arena-invitations
                  data-person-picker
                  data-person-input-name="Input.InvitationProfileIds"
                  data-person-purpose="arena"
                  data-search-url="@Url.Content("~/api/personen/suche")">
            <legend>Einladungen</legend>
            <p class="muted">Nur ausgewählte, bereits angemeldete Profile können diesem Raum beitreten.</p>
            @if (Model.Departments.Count > 0)
            {
                <label>
                    LDAP-Abteilung/Team
                    <select data-person-department>
                        <option value="">Alle verfügbaren Personen</option>
                        @foreach (var department in Model.Departments)
                        {
                            <option value="@department">@department</option>
                        }
                    </select>
                </label>
            }
            <label>
                Person suchen
                <input type="search" data-person-query autocomplete="off" placeholder="Name oder Konto" />
            </label>
            <div class="person-picker-results" data-person-results role="listbox" aria-label="Suchergebnisse"></div>
            <button type="button" class="secondary" data-person-more hidden>Weitere Personen laden</button>
            <p class="muted" data-person-status role="status" aria-live="polite">Personen werden geladen …</p>
            <div class="person-picker-selection">
                <strong>Ausgewählt</strong>
                <div class="person-picker-chips" data-person-selection>
                    @foreach (var person in Model.SelectedInvitations)
                    {
                        <span class="person-picker-chip" data-person-id="@person.Id" data-person-label="@person.DisplayName" data-person-account="@person.SamAccountName">
                            <span>@person.DisplayName <span class="muted">(@person.SamAccountName)</span></span>
                            <button type="button" class="secondary" data-person-remove aria-label="@person.DisplayName entfernen">Entfernen</button>
                            <input type="hidden" name="Input.InvitationProfileIds" value="@person.Id" />
                        </span>
                    }
                </div>
                @if (Model.SelectedInvitations.Count == 0)
                {
                    <p class="muted" data-person-empty>Noch niemand ausgewählt.</p>
                }
                else
                {
                    <p class="muted" data-person-empty hidden>Noch niemand ausgewählt.</p>
                }
                <span asp-validation-for="Input.InvitationProfileIds"></span>
            </div>
        </fieldset>
        <label>
            Maximale Teilnehmer
            <input asp-for="Input.MaxParticipants" type="number" min="2" max="@Model.MaxParticipantsLimit" />
            <span asp-validation-for="Input.MaxParticipants"></span>
        </label>
        <button type="submit">Raum erstellen</button>
    </form>
    <aside class="card arena-create-preview" aria-label="Beispielansicht eines Arena-Rennens">
        <h2>So sieht der Raum aus</h2>
        <p class="muted">Der Zieltext steht oben, die Eingabe direkt darunter. Im Live-Textboard siehst du den Fortschritt der anderen nicht als WPM-Zahl, sondern am Text selbst.</p>
        <div class="arena-mode-example">
            <div class="mode-example-strip">
                <span>Warten</span>
                <span>3</span>
                <span>2</span>
                <span>1</span>
                <strong>LOS</strong>
            </div>
            <div class="mode-example-target">
                <span class="correct">Alle tippen denselben Text.</span><span class="mode-example-cursor" aria-hidden="true"></span><span class="pending"> Der Fortschritt wird live sichtbar.</span>
            </div>
            <div class="mode-example-board">
                <div class="mode-example-row current">
                    <strong>Du</strong>
                    <p><span class="correct">Alle tippen denselben Text.</span><span class="mode-example-cursor" aria-hidden="true"></span><span class="pending"> Der Fortschritt wird live sichtbar.</span></p>
                </div>
                <div class="mode-example-row">
                    <strong>Gegnerin</strong>
                    <p><span class="correct">Alle tippen denselben</span><span class="wrong"> Texr</span><span class="mode-example-cursor" aria-hidden="true"></span><span class="pending">. Der Fortschritt wird live sichtbar.</span></p>
                </div>
                <div class="mode-example-row">
                    <strong>Gast</strong>
                    <p><span class="correct">Alle tippen</span><span class="mode-example-cursor" aria-hidden="true"></span><span class="pending"> denselben Text. Der Fortschritt wird live sichtbar.</span></p>
                </div>
            </div>
        </div>
    </aside>
</section>

@section Scripts {
    <script type="module" src="~/js/arena-create.js" asp-append-version="true"></script>
}
