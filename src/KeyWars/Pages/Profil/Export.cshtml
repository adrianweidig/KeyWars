@page "/profil/export"
@model KeyWars.Pages.Profil.ExportModel
@{
    ViewData["Title"] = "Selbstexport";
}

<section class="page-header">
    <div>
        <h1>Selbstexport</h1>
        <p class="lead">Der Export enthält dein lokales Profil, Versuche, Missionen und Erfolge.</p>
    </div>
</section>

<section class="card">
    <pre class="preformatted" tabindex="0" role="region" aria-label="Exportierte Profildaten">@Model.Json</pre>
</section>
