@page "/tageschallenge"
@model KeyWars.Pages.TageschallengeModel
@{
    ViewData["Title"] = "Tageschallenge";
    ViewData["BodyClass"] = "daily-challenge-page typing-focus-page";
}

<section class="page-header daily-challenge-hero">
    <div>
        <span class="eyebrow">Tageswertung</span>
        <h1>Tageschallenge</h1>
        <p class="lead">Ein fokussierter Tageslauf mit festem Text. Dein bestes gültiges Ergebnis der letzten 24 Stunden zählt.</p>
        <div class="hero-stat-row" aria-label="Challenge-Regeln">
            <span><strong>Bestwert</strong> der letzten 24 Stunden</span>
            <span><strong>@(Model.Text?.CharacterCount ?? 0)</strong> Zeichen</span>
            <span><strong>90%+</strong> Zielgenauigkeit</span>
        </div>
    </div>
</section>

@if (Model.Text is null)
{
    <section class="card empty-state">
        <h2>Keine Tageschallenge verfügbar</h2>
        <p>Es ist noch kein wertbarer Standardtext eingerichtet. Bitte wende dich an die Administration.</p>
        <a class="button secondary" asp-page="/Spielen/Index">Zum freien Training</a>
    </section>
}
else
{
<section class="card typing-session-card typing-focus-primary daily-challenge-card"
         data-typing-app
         data-mode="Text"
         data-text-id="@Model.Text.Id"
         data-auto-prepare="false"
         data-start-label="Tageschallenge starten"
         data-prepared-label="Lauf aktiv"
         data-finished-label="Nochmal trainieren"
         data-hide-start-when-prepared="true"
         data-idle-message="Heute zu schlagen: ein sauberer Lauf mit mindestens 90% Genauigkeit. Starte, wenn du bereit bist.">
    <div class="daily-challenge-card-head">
        <div>
            <span class="eyebrow">Heutiger Text</span>
            <h2>@Model.Text.Title</h2>
        </div>
        <span class="daily-challenge-badge">Bestes Ergebnis zählt</span>
    </div>
    <div class="typing-target" data-target tabindex="0" role="region" aria-label="Zieltext der Tageschallenge"></div>
    <label class="typing-input-wrap">
        Eingabe
        <textarea class="typing-input" data-input disabled autocapitalize="off" autocomplete="off" spellcheck="false"></textarea>
    </label>
    <div class="form-actions typing-actions">
        <button type="button" data-start>Tageschallenge starten</button>
    </div>
    <div data-result></div>
</section>

<div class="page-actions">
    <a class="button secondary"
       asp-page="/Ranglisten"
       asp-route-board="text"
       asp-route-period="day"
       asp-route-textId="@Model.Text.Id">24h-Wertung dieses Textes</a>
</div>
}
