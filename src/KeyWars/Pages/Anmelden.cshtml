@page "/anmelden"
@model KeyWars.Pages.AnmeldenModel
@{
    ViewData["Title"] = "Anmelden";
    ViewData["BodyClass"] = "auth-entry-page";
}

<div class="auth-entry-brand">
    <span class="brand"><span class="brand-mark" aria-hidden="true">KW</span>KeyWars</span>
    <button type="button" class="icon-button" data-theme-toggle aria-label="Helles Design aktivieren" aria-pressed="false"><span data-theme-icon="light">@UiIcons.Svg("sun")</span><span data-theme-icon="dark">@UiIcons.Svg("moon")</span></button>
</div>

<section class="page-header">
    <div>
        <h1>Anmelden</h1>
        <p class="lead">Melde dich mit deinem Active-Directory-Konto an. Dein Trainingsprofil wird beim ersten Anmelden angelegt.</p>
    </div>
</section>

<section class="card">
    <form method="post" class="form-grid" autocomplete="off" data-submit-guard data-submit-busy-text="Anmeldung läuft …">
        <div asp-validation-summary="ModelOnly" role="alert" aria-live="assertive" aria-atomic="true" tabindex="-1"></div>
        <label>
            Benutzername
            <input asp-for="Input.Username" autocomplete="username" aria-describedby="login-username-error" autofocus />
            <span id="login-username-error" asp-validation-for="Input.Username"></span>
        </label>
        <label>
            Passwort
            <input asp-for="Input.Password" type="password" autocomplete="current-password" aria-describedby="login-password-error" />
            <span id="login-password-error" asp-validation-for="Input.Password"></span>
        </label>
        <button type="submit">Anmelden</button>
    </form>
</section>
