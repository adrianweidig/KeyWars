@page "/herausforderungen/{id:guid}"
@model KeyWars.Pages.Herausforderungen.DetailsModel
@{
    ViewData["Title"] = Model.CurrentChallenge.Title;
}

<section class="page-header">
    <div>
        <h1>@Model.CurrentChallenge.Title</h1>
        <p class="lead">@Model.Text.Title · @DisplayNames.For(Model.CurrentChallenge.Mode) · @Model.CurrentChallenge.RoundCount Runde@(Model.CurrentChallenge.RoundCount == 1 ? "" : "n") · Ablauf @Model.CurrentChallenge.ExpiresAt.LocalDateTime.ToString("g")</p>
    </div>
    <div class="page-actions">
        @if (Model.CanJoin)
        {
            <form method="post" asp-page-handler="Join">
                <button type="submit" class="secondary">Annehmen</button>
            </form>
        }
        @if (Model.CanDecline)
        {
            <form method="post" asp-page-handler="Decline">
                <button type="submit" class="secondary">Ablehnen</button>
            </form>
        }
        @if (Model.CanPlay)
        {
            <a class="button" asp-page="/Herausforderungen/Spielen" asp-route-id="@Model.CurrentChallenge.Id">Runde @(Model.CurrentCompletedRounds + 1) spielen</a>
        }
        @if (Model.CanCancel)
        {
            <form method="post" asp-page-handler="Cancel">
                <button type="submit" class="secondary">Herausforderung abbrechen</button>
            </form>
        }
        @if (Model.CanRematch)
        {
            <form method="post" asp-page-handler="Rematch">
                <button type="submit">Revanche mit gleicher Gruppe</button>
            </form>
        }
    </div>
</section>

<div asp-validation-summary="ModelOnly" role="alert" aria-live="assertive"></div>

<section class="card">
    <table class="table">
        <thead><tr><th>Person</th><th>Status</th><th>Runden</th><th>Siege</th><th>Platz</th><th>Rating</th></tr></thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
                <tr>
                    <td data-label="Person">@row.DisplayName</td>
                    <td data-label="Status"><span class="pill">@DisplayNames.For(row.Status)</span></td>
                    <td data-label="Runden">@row.CompletedRounds / @Model.CurrentChallenge.RoundCount</td>
                    <td data-label="Siege">@row.RoundWins</td>
                    <td data-label="Platz">@(row.Placement?.ToString() ?? "-")</td>
                    <td data-label="Rating">@row.RatingDelta.ToString("+0;-0;0")</td>
                </tr>
        }
        </tbody>
    </table>
</section>
