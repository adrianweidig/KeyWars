@page "/herausforderungen/neu"
@model KeyWars.Pages.Herausforderungen.NeuModel
@{
    ViewData["Title"] = "Neue Herausforderung";
}

<section class="page-header">
    <div>
        <h1>Gruppe herausfordern</h1>
        <p class="lead">Wähle mindestens eine weitere Person. Noch nie angemeldete AD-Konten erscheinen hier bewusst nicht.</p>
    </div>
</section>

<section class="card">
    <form method="post" class="form-grid" data-challenge-create>
        <div asp-validation-summary="ModelOnly" role="alert" aria-live="assertive"></div>
        <input asp-for="Input.RequestId" type="hidden" />
        <label>
            Titel
            <input asp-for="Input.Title" />
        </label>
        <label>
            Text
            <select asp-for="Input.TrainingTextId">
                @foreach (var text in Model.Texts)
                {
                    <option value="@text.Id" selected="@(text.Id == Model.Input.TrainingTextId)">@text.Title</option>
                }
            </select>
        </label>
        <label>
            Modus
            <select asp-for="Input.Mode" data-challenge-mode>
                <option value="Classic">Klassisches Rennen</option>
                <option value="BestOf">Best-of-Serie</option>
            </select>
        </label>
        <label data-challenge-rounds>
            Runden
            <select asp-for="Input.RoundCount">
                <option value="1">1 Runde</option>
                <option value="3">Best of 3</option>
                <option value="5">Best of 5</option>
            </select>
        </label>
        <label>
            Ablauf in Tagen
            <input asp-for="Input.ExpiryDays" type="number" min="1" max="30" />
        </label>
        <fieldset class="person-picker" data-person-picker data-search-url="@Url.Content("~/api/personen/suche")" data-person-purpose="challenge">
            <legend>Personen</legend>
            <p class="muted">Suche serverseitig nach Namen oder Konto. Optional kannst du auf deine LDAP-Abteilung bzw. dein Team eingrenzen.</p>
            @if (Model.Departments.Count > 0)
            {
                <label>
                    LDAP-Abteilung/Team
                    <select data-person-department>
                        <option value="">Alle verfügbaren Personen</option>
                        @foreach (var department in Model.Departments)
                        {
                            <option value="@department">@department</option>
                        }
                    </select>
                </label>
            }
            <label>
                Person suchen
                <input type="search" data-person-query autocomplete="off" placeholder="Name oder Konto" />
            </label>
            <div class="person-picker-results" data-person-results role="listbox" aria-label="Suchergebnisse"></div>
            <button type="button" class="secondary" data-person-more hidden>Weitere Personen laden</button>
            <p class="muted" data-person-status role="status" aria-live="polite">Tippe einen Namen ein oder zeige die erste Seite an.</p>

            <div class="person-picker-selection">
                <strong>Ausgewählt</strong>
                <div class="person-picker-chips" data-person-selection>
                    @foreach (var person in Model.SelectedPeople)
                    {
                        <span class="person-picker-chip" data-person-id="@person.Id" data-person-label="@person.DisplayName" data-person-account="@person.SamAccountName">
                            <span>@person.DisplayName <span class="muted">(@person.SamAccountName)</span></span>
                            <button type="button" class="secondary" data-person-remove aria-label="@person.DisplayName entfernen">Entfernen</button>
                            <input type="hidden" name="Input.ParticipantIds" value="@person.Id" />
                        </span>
                    }
                </div>
                @if (Model.SelectedPeople.Count == 0)
                {
                    <p class="muted" data-person-empty>Noch niemand ausgewählt.</p>
                }
                else
                {
                    <p class="muted" data-person-empty hidden>Noch niemand ausgewählt.</p>
                }
                <span asp-validation-for="Input.ParticipantIds"></span>
            </div>
        </fieldset>
        <button type="submit">Herausforderung senden</button>
    </form>
</section>

@section Scripts {
    <script type="module" src="~/js/challenge-create.js" asp-append-version="true"></script>
}
