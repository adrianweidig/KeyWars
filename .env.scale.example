KEYWARS_IMAGE=ghcr.io/adrianweidig/keywars
KEYWARS_VERSION=v0.5.0
KEYWARS_BIND_ADDRESS=127.0.0.1
KEYWARS_PORT=8080
KEYWARS_SECRETS_DIRECTORY=./secrets

KEYWARS_LDAP_URLS=ldaps://dc01.example.local:636;ldaps://dc02.example.local:636
KEYWARS_LDAP_BASE_DN=DC=example,DC=local
KEYWARS_LDAP_UPN_SUFFIX=example.local
KEYWARS_LDAP_USER_BASE_DN=
KEYWARS_LDAP_CA_FILE=./secrets/ldap-ca.crt
KEYWARS_LDAP_ALLOW_STARTTLS=false
KEYWARS_MODERATOR_GROUP_DNS=
KEYWARS_MODERATOR_GROUP_VALUES=
KEYWARS_PROXY_KNOWN_NETWORKS=172.16.0.0/12
KEYWARS_TIME_ZONE=Europe/Berlin

KEYWARS_WEB_REPLICAS=2
KEYWARS_ARENA_REPLICAS=2
KEYWARS_WORKER_REPLICAS=1
KEYWARS_MAX_LIVE_PARTICIPANTS=64
KEYWARS_MAX_LIVE_ROOMS=200
KEYWARS_MAX_CONNECTIONS_PER_USER=3
KEYWARS_LIVE_BROADCAST_HZ=10

KEYWARS_RETENTION_ENABLED=false
KEYWARS_RETENTION_DRY_RUN=true
KEYWARS_RETENTION_INTERVAL_HOURS=24
OTEL_EXPORTER_OTLP_ENDPOINT=
