KEYWARS_IMAGE=ghcr.io/adrianweidig/keywars
KEYWARS_VERSION=latest
KEYWARS_BIND_ADDRESS=127.0.0.1
KEYWARS_PORT=8080

KEYWARS_LDAP_URLS=ldaps://dc01.example.local:636;ldaps://dc02.example.local:636
KEYWARS_LDAP_BASE_DN=DC=example,DC=local
KEYWARS_LDAP_UPN_SUFFIX=example.local
KEYWARS_LDAP_USER_BASE_DN=
KEYWARS_LDAP_CA_CERTIFICATE_PATH=
KEYWARS_LDAP_ALLOW_STARTTLS=false
KEYWARS_LDAP_CONNECT_TIMEOUT_SECONDS=5
KEYWARS_LDAP_OPERATION_TIMEOUT_SECONDS=10

KEYWARS_PROXY_KNOWN_PROXIES=
KEYWARS_PROXY_KNOWN_NETWORKS=

KEYWARS_TIME_ZONE=Europe/Berlin
KEYWARS_MAX_CHALLENGE_PARTICIPANTS=64
KEYWARS_MAX_LIVE_PARTICIPANTS=64
KEYWARS_MAX_LIVE_ROOMS=200
KEYWARS_MAX_CONNECTIONS_PER_USER=3
KEYWARS_LIVE_BROADCAST_HZ=10
KEYWARS_LIVE_COUNTDOWN_SECONDS=3
KEYWARS_LIVE_RECONNECT_SECONDS=30
KEYWARS_LIVE_COMMAND_QUEUE_CAPACITY=4096
KEYWARS_LIVE_COMPLETION_QUEUE_CAPACITY=4096
KEYWARS_LIVE_COMPLETION_DRAIN_TIMEOUT_SECONDS=10
KEYWARS_LIVE_COMPLETED_ROOM_RETENTION_MINUTES=60
KEYWARS_LIVE_LOBBY_ROOM_RETENTION_MINUTES=720
KEYWARS_MAX_ARENA_TARGET_GRAPHEMES=2800
